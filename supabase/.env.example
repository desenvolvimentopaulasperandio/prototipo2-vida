# Modelo dos secrets da Edge Function. NÃO coloque valores reais aqui nem em nenhum arquivo do repositório.
# Configure no Supabase: Edge Functions -> Secrets (ou `supabase secrets set NOME=valor`).

EVENTO_WEBHOOK_URL=            # obrigatório: URL que recebe as inscrições (POST JSON)
ALLOWED_ORIGINS=               # obrigatório em produção: https://seudominio.com.br,https://www.seudominio.com.br
# RATE_LIMIT_MAX=8             # opcional: envios por IP por janela
# RATE_LIMIT_WINDOW_SEC=600    # opcional
# WEBHOOK_TIMEOUT_MS=8000      # opcional
# RATE_LIMIT_SALT=             # opcional: sal do hash do IP

# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetados automaticamente pelo Supabase. Não os copie para lugar nenhum.
